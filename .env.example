# 复制为 .env.local，填入项目 Connect 面板中的 URL 和 Publishable Key。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 仅服务端使用。在 Settings > API Keys 复制 sb_secret_...，手动填入 .env.local。
# 普通 SSR 客户端不使用此密钥；用于 seed:demo 及阶段 5 经身份校验的服务端聊天图片上传/清理。
SUPABASE_SECRET_KEY=

# 阶段 5：OpenRouter。以下变量仅在服务端使用，不添加 NEXT_PUBLIC_ 前缀。
# BASE_URL 填 https://openrouter.ai/api/v1；MODEL 填模型页的完整 ID。
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# 阶段 6：Coze 独立无历史单轮工具，仅服务端使用。
# BASE_URL 填 https://api.coze.cn；BOT_ID 填目标 Agent ID；API_KEY 填具备 chat 权限的令牌。
COZE_BASE_URL=
COZE_API_KEY=
COZE_BOT_ID=
